#include <stdio.h>
int main (){
    int a;
    printf("Enter The No.:");
    scanf("%d", &a);

    if  (a>=90  && a<=100) {
        printf("You Got An A+ Grade...");
    }
    else if (a>=70 &&  a<=89) {
        printf("You Got An B+ Grade...");
    }
    else if (a>=50 && a<=69) {
        printf("You Got An C+ Grade...");
    }
    else if (a>=35 && a<=49) {
        printf("You Got An D+ Grade...");
    }
    else {
        printf("You Got Failed In The Exam...");
    }
    
    
}
